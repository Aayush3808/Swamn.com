{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev -- --port 5199",
  "installCommand": "npm install --frozen-lockfile",
  "framework": "tanstack-start",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "functions": {
    "api/**/*.{js,ts}": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1",
      "headers": {
        "Cache-Control": "public, s-maxage=0, must-revalidate"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/",
      "status": 200
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "buildCache": {
    "nodeModulesFilePath": "package-lock.json"
  }
}
