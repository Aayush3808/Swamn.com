# Own backend (local by default, no extra charges). Lovable AI key untouched.
JWT_SECRET="change-me-to-a-long-random-string"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@123"

# Optional Turso (serverless free tier): set both to use cloud DB instead of ./data/team.db
# TURSO_DATABASE_URL="libsql://..."
# TURSO_AUTH_TOKEN="..."

# Optional single Gmail Drive (leave unset for local ./data/files storage):
# 1. Create a folder in Drive, copy its folder ID from the URL
# 2. Run: node scripts/setup-drive.js   (or set GOOGLE_CLIENT_ID/SECRET env vars first)
# 3. Paste the printed values here
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REFRESH_TOKEN=""
# DRIVE_ROOT_FOLDER_ID=""
